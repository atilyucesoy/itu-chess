# Local: npm run setup generates .env with a unique password and secret.
ADMIN_USERNAME=atil
ADMIN_NAME=Atıl
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
# Hosted: run supabase/schema.sql, then supply server-only values below.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=server-only-never-VITE-prefix
# APP_ORIGIN=https://your-site.onrender.com
# NODE_ENV=production
# ENABLE_DEVELOPER_MODE=1 # Local development only; ignored in production.
# PORT=3001
# BBP_PATH=/absolute/path/to/bbpPairings.exe
# ALLOW_LOCAL_DB=1 # Only for self-hosted persistent disks, never Render free.
